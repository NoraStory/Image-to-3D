# Copy this file to .env and fill in real values.
ARK_API_KEY=your_api_key_here

# Strong secret used by Flask. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me

# Optional: require this token for all /api requests (recommended when --host 0.0.0.0).
# WEB_TOKEN=your-long-random-token

# Optional model / security overrides.
# IMAGETO3D_MODEL=doubao-seed3d-2-0-260328
# IMAGETO3D_ALLOW_INSECURE_HOST=0
# IMAGETO3D_TRUST_PROXY_HEADERS=0
